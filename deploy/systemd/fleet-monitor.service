[Unit]
Description=fleet-monitor scheduled health check runner (serve)
After=network.target fleet-monitor-server.service
Requires=fleet-monitor-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fleet-monitor
Environment="PATH=/opt/fleet-monitor/.venv/bin"
Environment="PREFECT_HOME=/opt/fleet-monitor/.prefect"
Environment="PREFECT_API_URL=http://127.0.0.1:4200/api"
Environment="PYTHONPATH=/opt/fleet-monitor/src"
Environment="NO_PROXY=127.0.0.1,localhost,::1"
Environment="no_proxy=127.0.0.1,localhost,::1"
ExecStart=/opt/fleet-monitor/.venv/bin/python -m fleet_monitor.cli serve -n fleet-health-30min
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
